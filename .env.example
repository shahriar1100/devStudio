# Public production URL: replace before deploying (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public contact links; empty values are hidden.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Private, server-only Resend configuration. All three are required to send.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Recommended in production: shared atomic rate limiting using Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Production email stays unavailable without shared rate limiting.
